<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudMon" Width="270" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">

    <!-- border2 stacked twice: Claude on top, Codex below, one divider between.
         The Tool menu is ignored for this skin. Element names ending in "2" are
         the Codex block; widget.ps1 fills them from Get-CodexUsage. -->
    <Border x:Name="Root" CornerRadius="14" Margin="6"
            Background="#B8121417" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Margin="13,10,13,11">

            <!-- ===== Claude ===== -->
            <TextBlock Text="Claude" Foreground="#9AA0A6"
                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
            <Grid Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#4ADE80"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtMain" Text="--" Foreground="#FFFFFF"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TxtReset" Text="" Foreground="#C8C8C8"
                           FontFamily="Segoe UI" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Border x:Name="BarTrack" Height="5" CornerRadius="3" Background="#33FFFFFF"/>
                <Border x:Name="BarFill" Height="5" CornerRadius="3" Width="0"
                        Background="#4ADE80" HorizontalAlignment="Left"/>
            </Grid>
            <Grid Margin="0,9,0,0">
                <TextBlock x:Name="TxtWeek" Text="--" Foreground="#D5D5D5"
                           FontFamily="Segoe UI" FontSize="11"/>
                <TextBlock x:Name="TxtWeekReset" Text="--" Foreground="#9AA0A6"
                           FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Border x:Name="WeekTrack" Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                <Border x:Name="WeekFill" Height="4" CornerRadius="2" Width="0"
                        Background="#7DA9F5" HorizontalAlignment="Left"/>
            </Grid>

            <Border Height="1" Background="#1AFFFFFF" Margin="0,11,0,10"/>

            <!-- ===== Codex ===== -->
            <TextBlock Text="Codex" Foreground="#9AA0A6"
                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
            <Grid Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#4ADE80"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtMain2" Text="--" Foreground="#FFFFFF"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TxtReset2" Text="" Foreground="#C8C8C8"
                           FontFamily="Segoe UI" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Border x:Name="BarTrack2" Height="5" CornerRadius="3" Background="#33FFFFFF"/>
                <Border x:Name="BarFill2" Height="5" CornerRadius="3" Width="0"
                        Background="#4ADE80" HorizontalAlignment="Left"/>
            </Grid>
            <Grid Margin="0,9,0,0">
                <TextBlock x:Name="TxtWeek2" Text="--" Foreground="#D5D5D5"
                           FontFamily="Segoe UI" FontSize="11"/>
                <TextBlock x:Name="TxtWeekReset2" Text="--" Foreground="#9AA0A6"
                           FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Border x:Name="WeekTrack2" Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                <Border x:Name="WeekFill2" Height="4" CornerRadius="2" Width="0"
                        Background="#7DA9F5" HorizontalAlignment="Left"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
