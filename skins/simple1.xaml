<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudMon" Width="150" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">

    <!-- 5-hour session only. No chrome at all: the numbers float on the
         wallpaper, and a drop shadow does the legibility work that a
         background panel would normally do. -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
        </Grid.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#4ADE80"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="TxtMain" Text="--" Foreground="#FFFFFF"
                           FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="TxtReset" Text="" Foreground="#D0D0D0"
                       FontFamily="Segoe UI" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
        </StackPanel>
    </Grid>
</Window>
