<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudMon" Width="270" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">

    <!-- Rounded translucent pill, 5-hour session only. The alpha lives in the
         Border brush, so the window Opacity setting can dim the whole thing on
         top of this. SizeToContent rather than a fixed Height: the text grows
         with the viewer's font scaling and a hardcoded number clips it. -->
    <Border x:Name="Root" CornerRadius="14" Margin="6"
            Background="#B8121417" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Margin="13,9,13,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#4ADE80"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtMain" Text="--" Foreground="#FFFFFF"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TxtReset" Text="" Foreground="#C8C8C8"
                           FontFamily="Segoe UI" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Border x:Name="BarTrack" Height="5" CornerRadius="3" Background="#33FFFFFF"/>
                <Border x:Name="BarFill" Height="5" CornerRadius="3" Width="0"
                        Background="#4ADE80" HorizontalAlignment="Left"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
