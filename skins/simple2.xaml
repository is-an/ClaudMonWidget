<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudMon" Width="250" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">

    <!-- Same bare treatment as simple1, in two columns: the 5-hour session on
         the left, the 7-day window on the right. Both columns read the same
         way down - percentage first, then time left - so the eye compares
         like with like across the divider. -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
        </Grid.Effect>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 5-hour session -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#4ADE80"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtMain" Text="--" Foreground="#FFFFFF"
                               FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TxtReset" Text="" Foreground="#D0D0D0"
                           FontFamily="Segoe UI" FontSize="12" Margin="16,1,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Width="1" Background="#59FFFFFF" Margin="16,4,16,4"/>

            <!-- 7-day window -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtWeek" Text="--" Foreground="#E3E3E3"
                           FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtWeekReset" Text="--" Foreground="#9AA0A6"
                           FontFamily="Segoe UI" FontSize="12" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
